        function handleRenewSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('renew-business-select').value;
            const b = businesses.find(item => item.id === id);
            if (!b) return;

            const inspectDate = document.getElementById('renew-inspect-date').value;
            const resultRadio = document.querySelector('input[name="inspect-result"]:checked').value;

            if (resultRadio === 'FAIL') {
                alert('ไม่สามารถต่ออายุใบอนุญาตได้ เนื่องจากสถานที่ไม่อยู่ในเกณฑ์ผ่านมาตรฐานการประเมินสุขลักษณะ');
                return;
            }

            // Extend license date 1 year from current exp date or today
            let baseDate = new Date(b.expDate);
            if (baseDate < new Date()) {
                baseDate = new Date();
            }
            baseDate.setFullYear(baseDate.getFullYear() + 1);

            b.expDate = baseDate.toISOString().split('T')[0];
            b.lastInspected = inspectDate;
            b.inspectStatus = resultRadio;

            saveToLocalStorage();
            refreshAllViews();

            alert(`ต่ออายุใบอนุญาตเรียบร้อยแล้ว!\nวันหมดอายุใหม่คือ: ${formatThaiDate(b.expDate)}`);
            

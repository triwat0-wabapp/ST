        // Helper: Status Calculation
        function getLicenseStatus(expDateStr) {
            const today = new Date();
            today.setHours(0,0,0,0);
            const expDate = new Date(expDateStr);
            expDate.setHours(0,0,0,0);

            const diffTime = expDate - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays < 0) {
                return { status: 'EXPIRED', days: diffDays, label: 'หมดอายุแล้ว', class: 'bg-rose-100 text-rose-800 border-rose-300' };
            } else if (diffDays <= 60) {
                return { status: 'EXPIRING', days: diffDays, label: `ใกล้หมดอายุ (${diffDays} วัน)`, class: 'bg-amber-100 text-amber-800 border-amber-300' };
            } else {
                return { status: 'ACTIVE', days: diffDays, label: 'ปกติ', class: 'bg-emerald-100 text-emerald-800 border-emerald-300' };
            }
        }

        // Thai Date Formatter
        function formatThaiDate(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            const thaiMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
            return `${date.getDate()} ${thaiMonths[date.getMonth()]} ${date.getFullYear() + 543}`;
        }

        // Thai Full Date Formatter
        function formatThaiFullDate(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            const thaiFullMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตูลายน', 'พฤศจิกายน', 'ธันวาคม'];
            return `${date.getDate()} เดือน ${thaiFullMonths[date.getMonth()]} พ.ศ. ${date.getFullYear() + 543}`;
        }

        // Convert Number to Thai Baht Text
        function ThaiBahtText(num) {
            if (!num || isNaN(num)) return 'ศูนย์บาทถ้วน';
            const numbers = ['ศูนย์', 'หนึ่ง', 'สอง', 'สาม', 'สี่', 'ห้า', 'หก', 'เจ็ด', 'แปด', 'เก้า'];
            const digits = ['', 'สิบ', 'ร้อย', 'พัน', 'หมื่น', 'แสน', 'ล้าน'];
            
            let [integer, fraction] = num.toFixed(2).split('.');
            let bahtText = '';
            
            let len = integer.length;
            for (let i = 0; i < len; i++) {
                let digit = parseInt(integer[i]);
                let pos = len - i - 1;
                if (digit !== 0) {
                    if (pos === 1 && digit === 1) bahtText += '';
                    else if (pos === 1 && digit === 2) bahtText += 'ยี่';
                    else if (pos === 0 && digit === 1 && len > 1) bahtText += 'เอ็ด';
                    else bahtText += numbers[digit];
                    bahtText += digits[pos];
                }
            }
            bahtText += 'บาท';

            if (fraction === '00') {
                bahtText += 'ถ้วน';
            } else {
                let f1 = parseInt(fraction[0]);
                let f2 = parseInt(fraction[1]);
                if (f1 !== 0) {
                    if (f1 === 1) bahtText += '';
                    else if (f1 === 2) bahtText += 'ยี่';
                    else bahtText += numbers[f1];
                    bahtText += 'สิบ';
                }
                if (f2 !== 0) {
                    if (f2 === 1 && f1 !== 0) bahtText += 'เอ็ด';
                    else bahtText += numbers[f2];
                }
                bahtText += 'สตางค์';
            }
            return bahtText;
        }


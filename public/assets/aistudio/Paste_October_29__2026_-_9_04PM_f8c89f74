        // ================= REPORTS & EXPORT =================
        function renderReports() {
            const tbody = document.getElementById('report-category-body');
            tbody.innerHTML = '';

            const categories = [
                '1. กิจการที่เกี่ยวกับการเลี้ยงสัตว์',
                '2. กิจการที่เกี่ยวกับอาหาร เครื่องดื่ม น้ำดื่ม',
                '3. กิจการที่เกี่ยวกับสถานบริการสาธารณสุข',
                '4. กิจการที่เกี่ยวกับสิ่งทอ',
                '5. กิจการที่เกี่ยวกับไม้หรือกระดาษ',
                '6. กิจการที่เกี่ยวกับงา ช้าง สัตว์ หรือกระดูก',
                '7. กิจการที่เกี่ยวกับสารเคมี',
                '8. กิจการที่เกี่ยวกับโลหะหรือแร่',
                '9. กิจการที่เกี่ยวกับยานยนต์ เครื่องจักร',
                '10. กิจการที่เกี่ยวกับอิฐ หิน ปูน ทราย',
                '11. กิจการที่เกี่ยวกับกระทบกระเทือนผู้คน',
                '12. กิจการบริการห้องพัก สถานบริการ',
                '13. กิจการอื่นๆ ตามประกาศกระทรวง'
            ];

            let grandCount = 0;
            let grandFee = 0;
            let grandFine = 0;

            categories.forEach(cat => {
                const list = businesses.filter(b => b.category === cat);
                if (list.length > 0) {
                    let totalFee = 0;
                    let totalFine = 0;

                    list.forEach(b => {
                        const fee = Number(b.fee) || 0;
                        const st = getLicenseStatus(b.expDate);
                        const fine = st.status === 'EXPIRED' ? fee * 0.20 : 0;

                        totalFee += fee;
                        totalFine += fine;
                    });

                    const net = totalFee + totalFine;

                    grandCount += list.length;
                    grandFee += totalFee;
                    grandFine += totalFine;

                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-slate-50";
                    tr.innerHTML = `
                        <td class="py-3 px-4 font-semibold text-slate-800">${cat}</td>
                        <td class="py-3 px-4 text-center font-bold">${list.length}</td>
                        <td class="py-3 px-4 text-right font-mono">${totalFee.toLocaleString('th-TH', {minimumFractionDigits:2})}</td>
                        <td class="py-3 px-4 text-right font-mono text-rose-600">${totalFine.toLocaleString('th-TH', {minimumFractionDigits:2})}</td>
                        <td class="py-3 px-4 text-right font-mono font-bold text-emerald-800">${net.toLocaleString('th-TH', {minimumFractionDigits:2})}</td>
                    `;
                    tbody.appendChild(tr);
                }
            });

            document.getElementById('report-total-count').textContent = grandCount;
            document.getElementById('report-total-fee').textContent = grandFee.toLocaleString('th-TH', {minimumFractionDigits:2});
            document.getElementById('report-total-fine').textContent = grandFine.toLocaleString('th-TH', {minimumFractionDigits:2});
            document.getElementById('report-total-net').textContent = (grandFee + grandFine).toLocaleString('th-TH', {minimumFractionDigits:2});
        }

        // Export Data to CSV (Excel format with UTF-8 BOM)
        function exportToCSV() {
            let csvContent = "\uFEFF"; // UTF-8 BOM for Thai Excel support
            csvContent += "เลขที่ใบอนุญาต,ชื่อสถานประกอบการ,ผู้ขออนุญาต,เลขบัตรประชาชน,เบอร์โทร,ประเภทกิจการ,ที่อยู่,หมู่บ้าน,วันหมดอายุ,ค่าธรรมเนียม(บาท),สถานะ\n";

            businesses.forEach(b => {
                const st = getLicenseStatus(b.expDate);
                const row = [
                    `"${b.licenseNo}"`,
                    `"${b.shopName}"`,
                    `"${b.ownerName}"`,
                    `"${b.idCard}"`,
                    `"${b.phone}"`,
                    `"${b.category}"`,
                    `"${b.address}"`,
                    `"${b.village}"`,
                    `"${b.expDate}"`,
                    `"${b.fee}"`,
                    `"${st.label}"`
                ].join(",");
                csvContent += row + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `รายงานผู้ประกอบการ_เทศบาลตำบลพระซอง_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>

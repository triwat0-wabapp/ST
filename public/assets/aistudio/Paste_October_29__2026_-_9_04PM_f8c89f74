                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            @page {
                size: A4 portrait;
                margin: 15mm;
            }
            .page-break {
                page-break-after: always;
            }
        }

        .border-double-custom {
            border: 4px double #1e3a8a;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- TOP HEADER / BANNER -->
    <header class="bg-gradient-to-r from-emerald-800 via-teal-800 to-emerald-900 text-white shadow-lg no-print">
        <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4 text-center md:text-left">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center p-2 border-2 border-amber-300/50 shadow-inner flex-shrink-0">
                    <i class="fa-solid me-0 fa-shield-halved text-3xl text-amber-300"></i>
                </div>
                <div>
                    <div class="inline-flex items-center gap-2 bg-amber-400 text-slate-900 text-xs font-bold px-2.5 py-0.5 rounded-full mb-1">
                        <i class="fa-solid fa-check-circle"></i> ระบบบริการราชการดิจิทัล (Smart Municipality)
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight">ระบบบริการและจัดการต่อใบอนุญาตประกอบกิจการที่เป็นอันตรายต่อสุขภาพ</h1>
                    <p class="text-emerald-200 text-sm">กองสาธารณสุขและสิ่งแวดล้อม เทศบาลตำบลพระซอง อำเภอนาแก จังหวัดนครพนม</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-sm border border-white/10">
                <div class="text-right text-xs">
                    <p class="text-emerald-200">เข้าสู่ระบบโดย</p>
                    <p class="font-semibold text-white">เจ้าพนักงานสาธารณสุข</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-amber-400 text-emerald-950 font-bold flex items-center justify-center border-2 border-white shadow">
                    สธ
                </div>
            </div>
        </div>

        <!-- NAVIGATION TABS -->
        <nav class="bg-emerald-950/60 border-t border-emerald-700/50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex space-x-1 overflow-x-auto py-2 text-sm font-medium scrollbar-none">
                    <button onclick="switchTab('dashboard')" id="tab-dashboard" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap bg-emerald-600 text-white shadow">
                        <i class="fa-solid fa-chart-pie"></i> แดชบอร์ดภาพรวม
                    </button>
                    <button onclick="switchTab('businesses')" id="tab-businesses" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap text-emerald-100 hover:bg-emerald-800/60">
                        <i class="fa-solid fa-store"></i> ทะเบียนผู้ประกอบการ
                    </button>
                    <button onclick="switchTab('renew')" id="tab-renew" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap text-emerald-100 hover:bg-emerald-800/60">
                        <i class="fa-solid fa-file-signature"></i> ยื่นต่ออายุ / ตรวจสุขลักษณะ
                    </button>
                    <button onclick="switchTab('notifications')" id="tab-notifications" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap text-emerald-100 hover:bg-emerald-800/60 relative">
                        <i class="fa-solid fa-bell"></i> แจ้งเตือนหมดอายุ & LINE
                        <span id="badge-expiring-count" class="bg-rose-500 text-white text-xs px-1.5 py-0.5 rounded-full font-bold">0</span>
                    </button>
                    <button onclick="switchTab('documents')" id="tab-documents" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap text-emerald-100 hover:bg-emerald-800/60">
                        <i class="fa-solid fa-print"></i> พิมพ์เอกสาร / ออกใบเสร็จ
                    </button>
                    <button onclick="switchTab('reports')" id="tab-reports" class="nav-tab px-4 py-2 rounded-lg transition-all flex items-center gap-2 whitespace-nowrap text-emerald-100 hover:bg-emerald-800/60">
                        <i class="fa-solid fa-file-invoice-dollar"></i> รายงานสรุป
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full no-print">

        <!-- ================= PAGE 1: DASHBOARD ================= -->
        <section id="page-dashboard" class="tab-content space-y-6">
            <!-- Alert Banner -->
            <div id="dashboard-alert" class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl shadow-sm flex items-start justify-between">
                <div class="flex items-start gap-3">
                    <i class="fa-solid fa-triangle-exclamation text-amber-500 text-xl mt-0.5"></i>
                    <div>
                        <h4 class="font-bold text-amber-800">แจ้งเตือนใบอนุญาตใกล้หมดอายุ!</h4>
                        <p class="text-sm text-amber-700 mt-0.5" id="dashboard-alert-text">มีใบอนุญาตจำนวน - รายที่กำลังจะหมดอายุภายใน 60 วัน กรุณาตรวจสอบและส่งหนังสือแจ้งเตือน</p>
                    </div>
                </div>
                <button onclick="switchTab('notifications')" class="text-xs bg-amber-600 hover:bg-amber-700 text-white font-medium px-3 py-1.5 rounded-lg transition shadow-sm whitespace-nowrap">
                    ดูรายการทั้งหมด <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">ใบอนุญาตทั้งหมด</p>
                        <h3 class="text-2xl font-bold text-slate-800 mt-1" id="stat-total">0</h3>
                        <p class="text-xs text-slate-400 mt-1">กิจการในเขตเทศบาล</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-store"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">สถานะปกติ</p>
                        <h3 class="text-2xl font-bold text-emerald-600 mt-1" id="stat-active">0</h3>
                        <p class="text-xs text-emerald-600/80 mt-1"><i class="fa-solid fa-check"></i> ยังไม่หมดอายุ</p>
                    </div>
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-shield-check"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">ใกล้หมดอายุ</p>
                        <h3 class="text-2xl font-bold text-amber-500 mt-1" id="stat-expiring">0</h3>
                        <p class="text-xs text-amber-600/80 mt-1"><i class="fa-solid fa-clock"></i> ภายใน 30-60 วัน</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">หมดอายุแล้ว</p>
                        <h3 class="text-2xl font-bold text-rose-600 mt-1" id="stat-expired">0</h3>
                        <p class="text-xs text-rose-600/80 mt-1"><i class="fa-solid fa-circle-exclamation"></i> ต้องต่ออายุทันที</p>
                    </div>
                    <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between sm:col-span-2 lg:col-span-1">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">รายได้ค่าธรรมเนียมรวม</p>
                        <h3 class="text-2xl font-bold text-teal-700 mt-1" id="stat-revenue">0 ฿</h3>
                        <p class="text-xs text-slate-400 mt-1">ปีงบประมาณปัจจุบัน</p>
                    </div>
                    <div class="w-12 h-12 bg-teal-50 text-teal-600 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Bar Chart: Business Categories -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 lg:col-span-2 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-chart-column text-emerald-600"></i> จำนวนกิจการแยกตามประเภท (13 กลุ่มอาชีพ)
                        </h3>
                        <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">พ.ร.บ. สาธารณสุข</span>
                    </div>
                    <div class="relative flex-1 min-h-[280px]">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>

                <!-- Doughnut Chart: License Status -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie text-emerald-600"></i> สัดส่วนสถานะใบอนุญาต
                        </h3>
                    </div>
                    <div class="relative flex-1 min-h-[240px] flex items-center justify-center">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Quick Action & Recent Expiring List -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Village Distribution Table -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 lg:col-span-2">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-emerald-600"></i> สรุปจำนวนกิจการแยกตามหมู่บ้าน (หมู่ 1 - หมู่ 16 ต.พระซอง)
                        </h3>
                        <button onclick="switchTab('businesses')" class="text-xs text-emerald-600 hover:text-emerald-800 font-semibold">
                            ดูทั้งหมด <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="text-xs text-slate-500 bg-slate-50 uppercase border-b border-slate-100">
                                <tr>
                                    <th class="py-2.5 px-3">หมู่ที่ / ชื่อหมู่บ้าน</th>
                                    <th class="py-2.5 px-3 text-center">กิจการทั้งหมด</th>
                                    <th class="py-2.5 px-3 text-center">ปกติ</th>
                                    <th class="py-2.5 px-3 text-center">ใกล้หมดอายุ</th>
                                    <th class="py-2.5 px-3 text-center">หมดอายุ</th>
                                </tr>
                            </thead>
                            <tbody id="village-summary-body" class="divide-y divide-slate-100 text-slate-700">
                                <!-- Dynamic JS Insert -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Quick Action Panel -->
                <div class="bg-gradient-to-br from-emerald-800 to-teal-900 text-white p-6 rounded-2xl shadow-md flex flex-col justify-between">
                    <div>
                        <div class="inline-block px-3 py-1 bg-amber-400 text-slate-900 rounded-full text-xs font-bold mb-3">
                            เมนูด่วน
                        </div>
                        <h3 class="text-xl font-bold mb-2">ทำรายการด่วน</h3>
                        <p class="text-emerald-200 text-sm mb-6">เลือกทำรายการที่ต้องการได้อย่างรวดเร็วเพื่ออำนวยความสะดวกแก่ผู้ประกอบการ</p>
                        
                        <div class="space-y-3">
                            <button onclick="openAddBusinessModal()" class="w-full py-2.5 px-4 bg-white text-emerald-900 hover:bg-emerald-50 rounded-xl font-bold text-sm shadow transition flex items-center justify-between">
                                <span><i class="fa-solid fa-plus-circle text-emerald-600 mr-2"></i> ลงทะเบียนกิจการใหม่</span>
                                <i class="fa-solid fa-chevron-right text-xs text-slate-400"></i>
                            </button>
                            <button onclick="switchTab('renew')" class="w-full py-2.5 px-4 bg-emerald-700/80 hover:bg-emerald-700 text-white rounded-xl font-semibold text-sm transition flex items-center justify-between border border-emerald-600/50">
                                <span><i class="fa-solid fa-arrows-rotate mr-2 text-amber-300"></i> บันทึกการต่ออายุ / ตรวจสุขลักษณะ</span>
                                <i class="fa-solid fa-chevron-right text-xs text-emerald-300"></i>
                            </button>
                            <button onclick="switchTab('notifications')" class="w-full py-2.5 px-4 bg-emerald-700/80 hover:bg-emerald-700 text-white rounded-xl font-semibold text-sm transition flex items-center justify-between border border-emerald-600/50">
                                <span><i class="fa-brands fa-line mr-2 text-emerald-300"></i> ส่งการแจ้งเตือน LINE / SMS</span>
                                <i class="fa-solid fa-chevron-right text-xs text-emerald-300"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-emerald-700/60 text-xs text-emerald-200 flex items-center justify-between">
                        <span>เทศบาลตำบลพระซอง</span>
                        <span>โทร. 042-XXX-XXX</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PAGE 2: BUSINESS REGISTER ================= -->
        <section id="page-businesses" class="tab-content space-y-6 hidden">
            <!-- Header & Search Controls -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-store text-emerald-600"></i> ทะเบียนผู้ประกอบการกิจการที่เป็นอันตรายต่อสุขภาพ
                    </h2>
                    <p class="text-sm text-slate-500">จัดการข้อมูลสถานประกอบการและประวัติใบอนุญาตในเขตเทศบาลตำบลพระซอง</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="openAddBusinessModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-xl text-sm shadow-sm transition flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> เพิ่มสถานประกอบการใหม่
                    </button>
                    <button onclick="resetToSampleData()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-2 rounded-xl text-sm transition flex items-center gap-1.5" title="โหลดข้อมูลตัวอย่าง">
                        <i class="fa-solid fa-rotate-right"></i> รีเซ็ตข้อมูลตัวอย่าง
                    </button>
                </div>
            </div>

            <!-- Filters -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">ค้นหา (ชื่อร้าน / ผู้ขอ / เลขใบอนุญาต)</label>
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
                        <input type="text" id="search-input" onkeyup="filterBusinesses()" placeholder="พิมพ์เพื่อค้นหา..." class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">ประเภทกิจการ</label>
                    <select id="filter-category" onchange="filterBusinesses()" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        <option value="ALL">-- ทุกประเภทกิจการ --</option>
                        <option value="1. กิจการที่เกี่ยวกับการเลี้ยงสัตว์">1. การเลี้ยงสัตว์</option>
                        <option value="2. กิจการที่เกี่ยวกับอาหาร เครื่องดื่ม น้ำดื่ม">2. อาหาร เครื่องดื่ม น้ำดื่ม</option>
                        <option value="3. กิจการที่เกี่ยวกับสถานบริการสาธารณสุข">3. สถานบริการสาธารณสุข</option>
                        <option value="4. กิจการที่เกี่ยวกับสิ่งทอ">4. สิ่งทอ / ตัดเย็บ</option>
                        <option value="5. กิจการที่เกี่ยวกับไม้หรือกระดาษ">5. ไม้หรือกระดาษ</option>
                        <option value="6. กิจการที่เกี่ยวกับงา ช้าง สัตว์ หรือกระดูก">6. งา/กระดูกสัตว์</option>
                        <option value="7. กิจการที่เกี่ยวกับสารเคมี">7. สารเคมี / คาร์แคร์</option>

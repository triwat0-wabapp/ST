        function onSelectRenewBusiness() {
            const id = document.getElementById('renew-business-select').value;
            const infoBox = document.getElementById('renew-selected-info');
            const btnSave = document.getElementById('btn-save-renew');

            if (!id) {
                infoBox.classList.add('hidden');
                btnSave.disabled = true;
                return;
            }

            const b = businesses.find(item => item.id === id);
            if (!b) return;

            infoBox.classList.remove('hidden');
            btnSave.disabled = false;

            const st = getLicenseStatus(b.expDate);

            document.getElementById('info-shop-name').textContent = b.shopName;
            document.getElementById('info-owner').textContent = b.ownerName;
            document.getElementById('info-idcard').textContent = b.idCard;
            document.getElementById('info-category').textContent = b.category;
            document.getElementById('info-address').textContent = `${b.address} ${b.village}`;
            document.getElementById('info-exp-date').textContent = formatThaiDate(b.expDate);
            document.getElementById('info-fee').textContent = b.fee.toLocaleString('th-TH');

            document.getElementById('info-status-badge').innerHTML = 
                `<span class="px-2.5 py-1 rounded-full text-xs font-bold border ${st.class}">${st.label}</span>`;

            // Calculate fees & fines
            const fee = Number(b.fee) || 0;
            let fine = 0;
            if (st.status === 'EXPIRED') {
                fine = fee * 0.20; // 20% fine for overdue
            }

            document.getElementById('calc-fee').textContent = fee.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';
            document.getElementById('calc-fine').textContent = fine.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';
            document.getElementById('calc-total').textContent = (fee + fine).toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';

            // Set default inspection date to today
            document.getElementById('renew-inspect-date').value = new Date().toISOString().split('T')[0];
        }

